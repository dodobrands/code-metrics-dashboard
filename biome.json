{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": ["**", "!vendor", "!data"]
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"javascript": {
		"globals": ["Chart", "ChartZoom"]
	}
}
